<view class="page">
  <view wx:if="{{isLoading}}" class="loading-card">正在读取攻略…</view>

  <view wx:if="{{errorMessage}}" class="message error-message">{{errorMessage}}</view>
  <button wx:if="{{status === 'error'}}" class="retry-button" type="primary" bindtap="onRetry">重新加载</button>
  <view wx:if="{{status === 'empty'}}" class="empty-card">暂时没有可用攻略。</view>

  <view wx:if="{{allVersions.length}}" class="version-card">
    <text class="section-title">历史版本</text>
    <view wx:for="{{allVersions}}" wx:key="value" class="version-status-row">
      <text>{{item.label}}</text><text class="version-status">{{item.statusLabel}}</text>
    </view>
    <picker wx:if="{{readyVersions.length > 1}}" mode="selector" range="{{readyVersionLabels}}" value="{{versionPickerIndex}}" bindchange="onVersionChange" disabled="{{isSwitching}}">
      <view class="version-picker">切换可查看版本<text class="chevron">⌄</text></view>
    </picker>
    <text wx:if="{{isSwitching}}" class="switching">正在切换版本…</text>
  </view>

  <block wx:if="{{plan}}">
    <view class="header-card">
      <text class="eyebrow">AI 旅行攻略</text>
      <text class="title">{{plan.cityName}} · {{plan.dateRange}}</text>
      <text class="traveler">{{plan.travelerText}}</text>
      <view class="header-meta">
        <text>版本：第 {{selectedVersion}} 版</text>
        <text>生成时间：{{plan.generatedAt}}</text>
        <text>总预算：{{plan.budgetTotalText}}</text>
      </view>
      <text class="summary">{{plan.summary}}</text>
    </view>

    <view class="section-card">
      <text class="section-title">每日行程</text>
      <view wx:for="{{plan.days}}" wx:key="dayNumber" class="day-card">
        <view class="day-heading">
          <text class="day-number">第 {{item.dayNumber}} 天</text>
          <text class="day-date">{{item.date}}</text>
        </view>
        <text class="day-summary">{{item.summary}}</text>

        <view class="weather-card">
          <view class="weather-heading">
            <text class="subsection-title">天气</text>
            <text class="source-tag">{{item.weather.sourceLabel}}</text>
          </view>
          <text class="weather-condition">{{item.weather.conditionText}}</text>
          <text wx:if="{{item.weather.temperatureText}}" class="weather-detail">{{item.weather.temperatureText}}</text>
          <text wx:if="{{item.weather.precipitationText}}" class="weather-detail">{{item.weather.precipitationText}}</text>
          <text wx:if="{{item.weather.notice}}" class="weather-notice">{{item.weather.notice}}</text>
        </view>

        <view class="timeline">
          <view wx:for="{{item.items}}" wx:key="id" class="timeline-item">
            <view class="timeline-time"><text>{{item.startTime}}</text><text>{{item.endTime}}</text></view>
            <view class="timeline-content">
              <view class="item-heading"><text class="item-type">{{item.typeLabel}}</text><text class="item-name">{{item.name}}</text></view>
              <text class="item-description">{{item.description}}</text>
              <text class="item-reason">推荐理由：{{item.recommendationReason}}</text>
              <text class="item-cost">预计 {{item.estimatedCostText}}</text>

              <view wx:if="{{item.place}}" class="place-block">
                <text class="block-label">地点</text>
                <text>{{item.place.name}} · {{item.place.categoryText}}</text>
                <text wx:if="{{item.place.address}}" class="muted">{{item.place.address}}</text>
                <text wx:if="{{item.place.ratingText}}" class="muted">{{item.place.ratingText}}</text>
                <text wx:if="{{item.place.openingHours}}" class="muted">开放时间：{{item.place.openingHours}}</text>
              </view>

              <view wx:if="{{item.route}}" class="route-block">
                <text class="block-label">路线 · {{item.route.modeLabel}}</text>
                <text wx:if="{{!item.route.isUnavailable}}">{{item.route.distanceText}} · {{item.route.durationText}}</text>
                <text wx:if="{{item.route.isUnavailable}}" class="muted">暂无可用路线数据</text>
                <text wx:if="{{item.route.tollText}}" class="muted">{{item.route.tollText}}</text>
              </view>
              <view wx:else class="route-block"><text class="block-label">路线</text><text class="muted">未提供路线信息</text></view>

              <view wx:if="{{item.tips.length}}" class="tips-block">
                <text class="block-label">小贴士</text>
                <text wx:for="{{item.tips}}" wx:key="*this" class="tip">{{item}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{item.warnings.length}}" class="warnings-block">
          <text class="block-label">当日提醒</text>
          <view wx:for="{{item.warnings}}" wx:key="message" class="warning"><text>{{item.severityLabel}}：{{item.message}}</text></view>
        </view>
        <text class="day-cost">当日预计 {{item.estimatedCostText}}</text>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">住宿建议</text>
      <view wx:if="{{plan.hotelRecommendations.length === 0}}" class="muted empty-line">暂无住宿建议</view>
      <view wx:for="{{plan.hotelRecommendations}}" wx:key="id" class="recommendation-card">
        <text class="recommendation-name">{{item.name}}</text>
        <text>{{item.description}}</text>
        <text class="item-reason">推荐理由：{{item.recommendationReason}}</text>
        <view wx:if="{{item.place}}" class="place-block"><text>{{item.place.name}}</text><text class="muted">{{item.place.address}}</text></view>
        <text wx:for="{{item.tips}}" wx:key="*this" class="tip">{{item}}</text>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">餐饮建议</text>
      <view wx:if="{{plan.foodRecommendations.length === 0}}" class="muted empty-line">暂无餐饮建议</view>
      <view wx:for="{{plan.foodRecommendations}}" wx:key="id" class="recommendation-card">
        <text class="recommendation-name">{{item.name}}</text>
        <text wx:if="{{item.cuisine}}" class="source-tag">{{item.cuisine}}</text>
        <text>{{item.description}}</text>
        <text class="item-reason">推荐理由：{{item.recommendationReason}}</text>
        <view wx:if="{{item.place}}" class="place-block"><text>{{item.place.name}}</text><text class="muted">{{item.place.address}}</text></view>
        <text wx:for="{{item.tips}}" wx:key="*this" class="tip">{{item}}</text>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">预算参考 · {{plan.budgetTotalText}}</text>
      <view wx:for="{{plan.budgetRows}}" wx:key="label" class="budget-row"><text>{{item.label}}</text><text>{{item.amountText}}</text></view>
    </view>

    <view class="section-card">
      <text class="section-title">交通建议</text>
      <view wx:if="{{plan.transportationTips.length === 0}}" class="muted empty-line">暂无交通建议</view>
      <text wx:for="{{plan.transportationTips}}" wx:key="*this" class="tip">{{item}}</text>
    </view>

    <view class="section-card last-card">
      <text class="section-title">通用提示</text>
      <view wx:if="{{plan.generalTips.length === 0}}" class="muted empty-line">暂无通用提示</view>
      <text wx:for="{{plan.generalTips}}" wx:key="*this" class="tip">{{item}}</text>
    </view>
  </block>
</view>
