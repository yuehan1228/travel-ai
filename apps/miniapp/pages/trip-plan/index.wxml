<view class="page">
  <view wx:if="{{isLoading}}" class="loading-card">正在读取攻略…</view>

  <view wx:if="{{errorMessage}}" class="message error-message">{{errorMessage}}</view>
  <button wx:if="{{status === 'error'}}" class="retry-button" type="primary" bindtap="onRetry">重新加载</button>
  <view wx:if="{{status === 'empty'}}" class="empty-card">暂时没有可用攻略。</view>

  <view wx:if="{{allVersions.length}}" class="version-card">
    <text class="section-title">历史版本</text>
    <view wx:for="{{allVersions}}" wx:key="value" class="version-status-row">
      <view class="version-row-main"><text>{{item.label}}</text><text class="version-status">{{item.statusLabel}}</text></view>
      <button
        wx:if="{{item.status === 'ready' && item.value != selectedVersion}}"
        class="restore-button"
        size="mini"
        data-version="{{item.value}}"
        bindtap="onRestoreVersion"
        loading="{{restoringVersion == item.value}}"
        disabled="{{restoringVersion !== undefined}}"
      >恢复此版本</button>
    </view>
    <picker wx:if="{{readyVersions.length > 1}}" mode="selector" range="{{readyVersionLabels}}" value="{{versionPickerIndex}}" bindchange="onVersionChange" disabled="{{isSwitching}}">
      <view class="version-picker">切换可查看版本<text class="chevron">⌄</text></view>
    </picker>
    <text wx:if="{{isSwitching}}" class="switching">正在切换版本…</text>
  </view>

  <view wx:if="{{readyVersions.length > 1}}" class="diff-card">
    <text class="section-title">版本差异</text>
    <view class="diff-picker-row">
      <picker mode="selector" range="{{diffVersionLabels}}" value="{{diffFromPickerIndex}}" bindchange="onDiffFromChange" disabled="{{isDiffLoading}}">
        <view class="diff-picker">对比前：{{diffVersionLabels[diffFromPickerIndex]}}<text class="chevron">⌄</text></view>
      </picker>
      <picker mode="selector" range="{{diffVersionLabels}}" value="{{diffToPickerIndex}}" bindchange="onDiffToChange" disabled="{{isDiffLoading}}">
        <view class="diff-picker">对比后：{{diffVersionLabels[diffToPickerIndex]}}<text class="chevron">⌄</text></view>
      </picker>
    </view>
    <button class="diff-button" size="mini" bindtap="onCompareVersions" loading="{{isDiffLoading}}" disabled="{{isDiffLoading}}">查看差异</button>
    <view wx:if="{{diff}}" class="diff-result">
      <text wx:if="{{!diff.hasChanges}}" class="muted">两个版本没有业务内容变化。</text>
      <view wx:for="{{diff.dayChanges}}" wx:key="dayNumber" class="diff-day">
        <text class="block-label">{{item.dayNumber === 0 ? '全局内容' : '第 ' + item.dayNumber + ' 天'}}</text>
        <view wx:for="{{item.changedFields}}" wx:key="*this" class="diff-field"><text>字段变化：{{item}}</text></view>
        <view wx:for="{{item.itemChanges}}" wx:key="itemId" class="diff-item">
          <text>{{item.changeType === 'added' ? '新增' : item.changeType === 'removed' ? '删除' : '修改'}}行程 {{item.itemId}}</text>
          <view wx:for="{{item.changedFields}}" wx:key="*this" class="diff-field"><text>· {{item}}</text></view>
        </view>
      </view>
      <view wx:if="{{diff.budgetDiff}}" class="diff-budget">
        <text class="block-label">预算：¥{{diff.budgetDiff.beforeTotalCny}} → ¥{{diff.budgetDiff.afterTotalCny}}</text>
        <view wx:for="{{diff.budgetDiff.changedFields}}" wx:key="*this" class="diff-field"><text>· {{item}}</text></view>
      </view>
    </view>
    <text wx:if="{{isDiffLoading}}" class="switching">正在读取差异…</text>
  </view>

  <block wx:if="{{plan}}">
    <view class="header-card">
      <text class="eyebrow">AI 旅行攻略</text>
      <text class="title">{{plan.cityName}} · {{plan.dateRange}}</text>
      <text class="traveler">{{plan.travelerText}}</text>
      <view class="header-meta">
        <text>版本：第 {{selectedVersion}} 版</text>
        <text>生成时间：{{plan.generatedAt}}</text>
        <text>总预算：{{plan.budgetTotalText}}</text>
      </view>
      <text class="summary">{{plan.summary}}</text>
    </view>

    <view wx:if="{{status === 'ready' && !isSwitching}}" class="edit-card">
      <text class="section-title">编辑攻略内容</text>
      <text class="muted">仅可修改摘要、每日摘要、行程描述/推荐理由/小贴士和金额；地点、路线、名称、提醒与来源不可修改。</text>
      <textarea
        class="edit-textarea"
        value="{{editSummary || plan.summary}}"
        maxlength="4000"
        placeholder="攻略摘要"
        bindinput="onEditSummaryInput"
        disabled="{{isEditing}}"
      />
      <view wx:for="{{plan.days}}" wx:for-item="dayItem" wx:key="dayNumber" class="edit-day-card">
        <text class="block-label">第 {{dayItem.dayNumber}} 天</text>
        <textarea class="edit-textarea" data-day-number="{{dayItem.dayNumber}}" data-field="summary" value="{{dayItem.editSummary}}" maxlength="2000" placeholder="每日摘要" bindinput="onEditDayInput" disabled="{{isEditing}}" />
        <view wx:for="{{dayItem.items}}" wx:for-item="planItem" wx:key="id" class="edit-item-card">
          <text class="muted">行程：{{planItem.name}}（名称不可编辑）</text>
          <textarea class="edit-textarea" data-day-number="{{dayItem.dayNumber}}" data-item-id="{{planItem.id}}" data-field="description" value="{{planItem.editDescription}}" maxlength="2000" placeholder="描述" bindinput="onEditItemInput" disabled="{{isEditing}}" />
          <textarea class="edit-textarea" data-day-number="{{dayItem.dayNumber}}" data-item-id="{{planItem.id}}" data-field="recommendationReason" value="{{planItem.editRecommendationReason}}" maxlength="1000" placeholder="推荐理由" bindinput="onEditItemInput" disabled="{{isEditing}}" />
          <textarea class="edit-textarea" data-day-number="{{dayItem.dayNumber}}" data-item-id="{{planItem.id}}" data-field="tips" value="{{planItem.editTips}}" maxlength="10000" placeholder="小贴士，每行一条" bindinput="onEditItemInput" disabled="{{isEditing}}" />
          <input class="edit-input" data-day-number="{{dayItem.dayNumber}}" data-item-id="{{planItem.id}}" data-field="estimatedCostCny" value="{{planItem.editEstimatedCostCny}}" maxlength="32" type="digit" placeholder="行程金额" bindinput="onEditItemInput" disabled="{{isEditing}}" />
        </view>
      </view>
      <button class="edit-button" size="mini" bindtap="onSubmitEdit" loading="{{isEditing}}" disabled="{{isEditing}}">保存为新版本</button>
    </view>

    <view class="section-card">
      <text class="section-title">每日行程</text>
      <view wx:for="{{plan.days}}" wx:key="dayNumber" class="day-card">
        <view class="day-heading">
          <text class="day-number">第 {{item.dayNumber}} 天</text>
          <text class="day-date">{{item.date}}</text>
        </view>
        <text class="day-summary">{{item.summary}}</text>

        <view class="day-regenerate-card">
          <text class="block-label">调整本日安排</text>
          <input
            class="day-regenerate-input"
            data-day-number="{{item.dayNumber}}"
            value="{{item.regenerateInstruction}}"
            maxlength="500"
            placeholder="可选：告诉我们希望如何调整"
            bindinput="onRegenerateInstructionInput"
            disabled="{{regeneratingDay !== undefined}}"
          />
          <button
            class="day-regenerate-button"
            size="mini"
            data-day-number="{{item.dayNumber}}"
            bindtap="onRegenerateDay"
            loading="{{item.isRegenerating}}"
            disabled="{{regeneratingDay !== undefined}}"
          >重新生成本日</button>
        </view>

        <view wx:if="{{item.hasReorderDraft}}" class="reorder-draft-card">
          <text class="block-label">顺序草稿</text>
          <text class="muted">上移/下移只修改本地草稿，保存前不会创建版本。</text>
          <view class="reorder-draft-actions">
            <button
              size="mini"
              data-day-number="{{item.dayNumber}}"
              bindtap="onRestoreReorder"
              disabled="{{reorderingItem !== undefined}}"
            >恢复原顺序</button>
            <button
              size="mini"
              type="primary"
              data-day-number="{{item.dayNumber}}"
              bindtap="onSaveReorder"
              loading="{{item.isReordering}}"
              disabled="{{reorderingItem !== undefined}}"
            >保存为新版本</button>
          </view>
        </view>

        <view class="weather-card">
          <view class="weather-heading">
            <text class="subsection-title">天气</text>
            <text class="source-tag">{{item.weather.sourceLabel}}</text>
          </view>
          <text class="weather-condition">{{item.weather.conditionText}}</text>
          <text wx:if="{{item.weather.temperatureText}}" class="weather-detail">{{item.weather.temperatureText}}</text>
          <text wx:if="{{item.weather.precipitationText}}" class="weather-detail">{{item.weather.precipitationText}}</text>
          <text wx:if="{{item.weather.notice}}" class="weather-notice">{{item.weather.notice}}</text>
        </view>

        <view class="timeline">
          <view wx:for="{{item.items}}" wx:key="id" class="timeline-item">
            <view class="timeline-time"><text>{{item.startTime}}</text><text>{{item.endTime}}</text></view>
            <view class="timeline-content">
              <view class="item-heading"><text class="item-type">{{item.typeLabel}}</text><text class="item-name">{{item.name}}</text></view>
              <view class="reorder-actions">
                <button
                  size="mini"
                  data-day-number="{{item.dayNumber}}"
                  data-item-id="{{item.id}}"
                  data-direction="up"
                  bindtap="onReorderItem"
                  loading="{{item.isReordering}}"
                  disabled="{{reorderingItem !== undefined}}"
                >上移</button>
                <button
                  size="mini"
                  data-day-number="{{item.dayNumber}}"
                  data-item-id="{{item.id}}"
                  data-direction="down"
                  bindtap="onReorderItem"
                  disabled="{{reorderingItem !== undefined}}"
                >下移</button>
              </view>
              <text class="item-description">{{item.description}}</text>
              <text class="item-reason">推荐理由：{{item.recommendationReason}}</text>
              <text class="item-cost">预计 {{item.estimatedCostText}}</text>

              <view wx:if="{{item.place}}" class="place-block">
                <text class="block-label">地点</text>
                <text>{{item.place.name}} · {{item.place.categoryText}}</text>
                <text wx:if="{{item.place.address}}" class="muted">{{item.place.address}}</text>
                <text wx:if="{{item.place.ratingText}}" class="muted">{{item.place.ratingText}}</text>
                <text wx:if="{{item.place.openingHours}}" class="muted">开放时间：{{item.place.openingHours}}</text>
              </view>

              <view wx:if="{{item.route}}" class="route-block">
                <text class="block-label">路线 · {{item.route.modeLabel}}</text>
                <text wx:if="{{!item.route.isUnavailable}}">{{item.route.distanceText}} · {{item.route.durationText}}</text>
                <text wx:if="{{item.route.isUnavailable}}" class="muted">暂无可用路线数据</text>
                <text wx:if="{{item.route.tollText}}" class="muted">{{item.route.tollText}}</text>
              </view>
              <view wx:else class="route-block"><text class="block-label">路线</text><text class="muted">未提供路线信息</text></view>

              <view wx:if="{{item.tips.length}}" class="tips-block">
                <text class="block-label">小贴士</text>
                <text wx:for="{{item.tips}}" wx:key="*this" class="tip">{{item}}</text>
              </view>
              <view wx:if="{{item.type === 'attraction' || item.type === 'food' || item.type === 'hotel'}}" class="replacement-block">
                <button
                  size="mini"
                  data-day-number="{{item.dayNumber}}"
                  data-item-id="{{item.id}}"
                  bindtap="onLoadReplacementCandidates"
                  loading="{{replacementLoadingItem === item.dayNumber + ':' + item.id}}"
                  disabled="{{replacementLoadingItem !== undefined || replacingItem !== undefined}}"
                >查找可替换地点</button>
                <view wx:for="{{item.replacementCandidates}}" wx:for-item="candidate" wx:key="id" class="replacement-candidate">
                  <text>{{candidate.name}}<text wx:if="{{candidate.address}}" class="muted"> · {{candidate.address}}</text><text wx:if="{{candidate.recommendationReason}}" class="muted"> · {{candidate.recommendationReason}}</text></text>
                  <button size="mini" data-day-number="{{item.dayNumber}}" data-item-id="{{item.id}}" data-place-id="{{candidate.id}}" bindtap="onSelectReplacementCandidate" loading="{{item.isReplacing && item.selectedReplacementPlaceId === candidate.id}}" disabled="{{replacingItem !== undefined}}">更换</button>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{item.warnings.length}}" class="warnings-block">
          <text class="block-label">当日提醒</text>
          <view wx:for="{{item.warnings}}" wx:key="message" class="warning"><text>{{item.severityLabel}}：{{item.message}}</text></view>
        </view>
        <text class="day-cost">当日预计 {{item.estimatedCostText}}</text>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">住宿建议</text>
      <view wx:if="{{plan.hotelRecommendations.length === 0}}" class="muted empty-line">暂无住宿建议</view>
      <view wx:for="{{plan.hotelRecommendations}}" wx:key="id" class="recommendation-card">
        <text class="recommendation-name">{{item.name}}</text>
        <text>{{item.description}}</text>
        <text class="item-reason">推荐理由：{{item.recommendationReason}}</text>
        <view wx:if="{{item.place}}" class="place-block"><text>{{item.place.name}}</text><text class="muted">{{item.place.address}}</text></view>
        <text wx:for="{{item.tips}}" wx:key="*this" class="tip">{{item}}</text>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">餐饮建议</text>
      <view wx:if="{{plan.foodRecommendations.length === 0}}" class="muted empty-line">暂无餐饮建议</view>
      <view wx:for="{{plan.foodRecommendations}}" wx:key="id" class="recommendation-card">
        <text class="recommendation-name">{{item.name}}</text>
        <text wx:if="{{item.cuisine}}" class="source-tag">{{item.cuisine}}</text>
        <text>{{item.description}}</text>
        <text class="item-reason">推荐理由：{{item.recommendationReason}}</text>
        <view wx:if="{{item.place}}" class="place-block"><text>{{item.place.name}}</text><text class="muted">{{item.place.address}}</text></view>
        <text wx:for="{{item.tips}}" wx:key="*this" class="tip">{{item}}</text>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">预算参考 · {{plan.budgetTotalText}}</text>
      <view wx:for="{{plan.budgetRows}}" wx:key="label" class="budget-row"><text>{{item.label}}</text><text>{{item.amountText}}</text></view>
    </view>

    <view class="section-card">
      <text class="section-title">交通建议</text>
      <view wx:if="{{plan.transportationTips.length === 0}}" class="muted empty-line">暂无交通建议</view>
      <text wx:for="{{plan.transportationTips}}" wx:key="*this" class="tip">{{item}}</text>
    </view>

    <view class="section-card last-card">
      <text class="section-title">通用提示</text>
      <view wx:if="{{plan.generalTips.length === 0}}" class="muted empty-line">暂无通用提示</view>
      <text wx:for="{{plan.generalTips}}" wx:key="*this" class="tip">{{item}}</text>
    </view>
  </block>
</view>
