.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 28rpx 72rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 16rpx 8rpx 28rpx;
}

.title {
  color: #111827;
  font-size: 42rpx;
  font-weight: 600;
}

.environment {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.subtitle {
  margin-top: 18rpx;
  color: #4b5563;
  font-size: 27rpx;
  line-height: 1.6;
}

.form-card,
.auth-card,
.health-card {
  box-sizing: border-box;
  width: 100%;
  padding: 32rpx 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 41, 55, 0.06);
}

.auth-card {
  margin-bottom: 28rpx;
}

.auth-button {
  margin: 0;
}

.health-card {
  margin-top: 28rpx;
}

.section-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 600;
}

.section-spaced {
  margin-top: 44rpx;
}

.field {
  margin-top: 28rpx;
}

.label {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  color: #374151;
  font-size: 28rpx;
  font-weight: 500;
}

.required {
  margin-left: 6rpx;
  color: #dc2626;
}

.optional,
.hint {
  margin-left: 8rpx;
  color: #9ca3af;
  font-size: 24rpx;
  font-weight: 400;
}

.input,
.picker-value,
.textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx 22rpx;
  color: #1f2937;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.picker-value {
  min-height: 40rpx;
}

.placeholder {
  color: #9ca3af;
}

.date-row {
  display: flex;
  gap: 20rpx;
}

.date-field {
  flex: 1;
  min-width: 0;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 360rpx;
  max-width: 100%;
}

.stepper-button {
  box-sizing: border-box;
  width: 76rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  color: #2563eb;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
  border-radius: 12rpx;
  font-size: 38rpx;
  line-height: 66rpx;
}

.stepper-value {
  min-width: 120rpx;
  color: #111827;
  font-size: 30rpx;
  text-align: center;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx 10rpx;
}

.option-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 28rpx;
}

.option {
  display: flex;
  min-height: 56rpx;
  align-items: center;
  color: #374151;
  font-size: 27rpx;
}

.option checkbox,
.option radio {
  margin-right: 8rpx;
  transform: scale(0.88);
}

.sub-options {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}

.custom-budget {
  margin-top: 18rpx;
}

.textarea {
  min-height: 160rpx;
  line-height: 1.5;
}

.character-count {
  margin-top: 8rpx;
  color: #9ca3af;
  font-size: 23rpx;
  text-align: right;
}

.error {
  margin-top: 10rpx;
  color: #dc2626;
  font-size: 24rpx;
  line-height: 1.5;
}

.submit-button {
  width: 100%;
  margin-top: 42rpx;
}

.clear-button {
  width: 100%;
  margin-top: 18rpx;
  color: #4b5563;
  background: #f3f4f6;
}

.form-message {
  margin-top: 20rpx;
  text-align: center;
}

.success-message {
  color: #15803d;
  font-size: 27rpx;
}

.health-button {
  width: 100%;
  margin-top: 24rpx;
}

.status {
  min-height: 40rpx;
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}

.status-idle,
.status-loading {
  color: #6b7280;
}

.status-success {
  color: #15803d;
}

.status-error {
  color: #b91c1c;
}
