.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 96rpx 40rpx;
  background: #f7f8fa;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.title {
  color: #111827;
  font-size: 40rpx;
  font-weight: 600;
}

.subtitle {
  max-width: 620rpx;
  margin-top: 24rpx;
  color: #6b7280;
  font-size: 27rpx;
  line-height: 1.6;
}

.status-card {
  display: flex;
  box-sizing: border-box;
  min-height: 360rpx;
  margin-top: 64rpx;
  padding: 64rpx 40rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(31, 41, 55, 0.07);
}

.spinner {
  width: 70rpx;
  height: 70rpx;
  border: 8rpx solid #dbeafe;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.phase-message {
  margin-top: 38rpx;
  color: #1d4ed8;
  font-size: 32rpx;
}

.hint {
  margin-top: 20rpx;
  color: #9ca3af;
  font-size: 24rpx;
}

.error-card {
  min-height: 260rpx;
}

.error-message {
  margin-bottom: 28rpx;
  color: #b91c1c;
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.error-card button {
  width: 100%;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
