{
  "name": "@travel-guide/monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "lint": "eslint \"apps/**/*.ts\" \"packages/**/*.ts\" eslint.config.mjs",
    "format": "prettier --write \"README.md\" \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig.base.json\" \"eslint.config.mjs\" \"apps/**/*.{ts,json,wxss}\" \"packages/**/*.{ts,json,md}\" \"docs/**/*.md\" \"infra/**/*.yml\"",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
