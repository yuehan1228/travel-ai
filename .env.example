# Application
NODE_ENV=development
PORT=3000

# PostgreSQL (used by the local compose stack; replace placeholders locally)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=travel_guide
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=travel_guide
POSTGRES_SSL=false
POSTGRES_POOL_MIN=0
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT_MS=10000
POSTGRES_CONNECTION_TIMEOUT_MS=5000

# Redis (REDIS_DB is the logical Redis database index)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-with-a-local-password
REDIS_DB=0

# 微信登录与应用 Access Token（仅服务端使用）
WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret
JWT_ACCESS_SECRET=replace-with-a-local-jwt-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN_SECONDS=7200

# Weather provider (server only; never expose WEATHER_API_KEY to the miniapp)
WEATHER_PROVIDER=amap
WEATHER_API_KEY=replace-with-weather-api-key
WEATHER_REQUEST_TIMEOUT_MS=5000
WEATHER_FORECAST_HORIZON_DAYS=4

# Place provider (server only; never expose PLACE_API_KEY to the miniapp)
PLACE_PROVIDER=amap
PLACE_API_KEY=replace-with-place-api-key
PLACE_REQUEST_TIMEOUT_MS=5000
PLACE_CACHE_TTL_SECONDS=3600

# Route provider (server only; never expose ROUTE_API_KEY to the miniapp)
ROUTE_PROVIDER=amap
ROUTE_API_KEY=replace-with-route-api-key
ROUTE_REQUEST_TIMEOUT_MS=5000
ROUTE_CACHE_TTL_SECONDS=3600
ROUTE_STALE_IF_ERROR_SECONDS=21600

# LLM provider (server only; never expose these values to the miniapp)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=8192
# Set true only for a local/test HTTP endpoint; production requires HTTPS.
LLM_ALLOW_INSECURE_LOCALHOST=false
